PGVECTOR_USER=crypto
# Replace before starting Compose: openssl rand -hex 32
PGVECTOR_PASSWORD=replace_with_random_hex
PGVECTOR_DB=crypto
DATABASE_URL=postgresql://crypto:replace_with_random_hex@localhost:5432/crypto

# OpenAI-compatible chat and embedding API
LLM_API_URL=https://api.example.com/v1
LLM_API_KEY=changeme_llm_api_key
LLM_MODEL=your_chat_model
EMBEDDING_MODEL=qwen3-embedding
RAGAS_JUDGE_MODEL=your_judge_model

# Live RAG acquisition. Compose overrides this with the private news service.
NEWS_API_URL=http://127.0.0.1:3000/api/news

# Optional alternative to `crypto-analyser news load --archive-dir ...`
NEWS_ARCHIVE_DIR=/path/to/free-crypto-news/archive
